        {
          "name": "Custom RPC: Sign Up (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.session && res.session.token) {",
                  "  pm.collectionVariables.set('sessionToken', res.session.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_email\": \"ouder@voorbeeld.nl\",\n  \"p_password\": \"SecurePassword123!\",\n  \"p_name\": \"Sanne de Vries\",\n  \"p_usage_mode\": \"together\"\n}"
